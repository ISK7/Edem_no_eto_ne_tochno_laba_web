{
  "name": "edem-no-eto-ne-tochno",
  "version": "1.0.0",
  "private": true,
  "description": "Информационная система записи на тест-драйв «Едем, но это не точно»",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch back/server.ts",
    "dev:web": "vite --config front/vite.config.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build --config front/vite.config.ts",
    "build:api": "tsc -p back/tsconfig.json",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./back/dist/server.js')\"",
    "typecheck": "tsc -p back/tsconfig.json --noEmit && tsc -p front/tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema back/prisma/schema.prisma",
    "db:push": "prisma db push --schema back/prisma/schema.prisma",
    "db:seed": "tsx back/prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "db:studio": "prisma studio --schema back/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "express": "4.22.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "10.0.7",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "engines": {
    "node": ">=20.12"
  }
}
