// Схема базы данных портала «Едем, но это не точно».
// SQLite не поддерживает enum, поэтому роли, статусы и типы оплаты
// хранятся строками и валидируются на уровне приложения.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  login        String         @unique
  passwordHash String
  fullName     String
  phone        String
  email        String         @unique
  role         String         @default("USER")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  requests     TestDriveRequest[]
}

model RefreshToken {
  jti        String    @id
  tokenHash  String
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model CarBrand {
  id     Int        @id @default(autoincrement())
  name   String     @unique
  models CarModel[]
}

model CarModel {
  id       Int     @id @default(autoincrement())
  name     String
  price    Int     @default(0)
  quantity Int     @default(0)
  brandId  Int
  brand    CarBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requests TestDriveRequest[]

  @@unique([brandId, name])
}

model TestDriveRequest {
  id              Int      @id @default(autoincrement())
  userId          Int
  carModelId      Int
  address         String
  contactPhone    String
  scheduledAt     DateTime
  licenseSeries   String
  licenseNumber   String
  licenseIssuedAt DateTime
  paymentType     String
  status          String   @default("PENDING")
  rejectionReason String?
  searchIndex     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  carModel        CarModel @relation(fields: [carModelId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}
